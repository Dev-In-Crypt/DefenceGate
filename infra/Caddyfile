# Caddy obtains and renews certificates on its own.
# DGATE_DOMAIN is set in infra/.env; it falls back to localhost for local runs.

{$DGATE_DOMAIN:localhost} {
	encode zstd gzip

	# No includeSubDomains until the domain is verified and every subdomain is ours.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# This API takes GET requests with short query strings and nothing else.
	request_body {
		max_size 4KB
	}

	# Only what the product serves reaches the API. /docs, /openapi.json and any
	# route added later and forgotten are a 404 here, whatever the application
	# does.
	@public path /v1/funding /v1/funding/* /v1/opportunities /v1/opportunities/* /v1/calls /v1/calls/* /v1/sources /v1/health /v1/organisations/resolve
	handle @public {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 20s
			}
		}
	}

	# Anything else under /v1 is not the site's: a 404 here, not a page from the
	# frontend that happens to answer it.
	@api_rest path /v1 /v1/*
	handle @api_rest {
		respond "Not found" 404
	}

	# The site (docker-compose `web` profile). Down until the domain is live: Caddy
	# resolves web:3000 per request, so it can start first and answers 502 meanwhile.
	handle {
		reverse_proxy web:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	log {
		output stdout
		format console
	}
}

# www is only a way in: send it to the one host the site and its certificate use.
# Needs a DNS record for www (CNAME to the apex, DNS only) before Caddy is reloaded,
# or the certificate request for it fails and is retried.
www.{$DGATE_DOMAIN} {
	redir https://{$DGATE_DOMAIN}{uri} permanent
}
