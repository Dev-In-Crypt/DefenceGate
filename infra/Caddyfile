# Caddy obtains and renews certificates on its own.
# DGATE_DOMAIN is set in infra/.env; it falls back to localhost for local runs.

# The default log (proxy errors such as "web is down" repeat the request, URI and Referer
# included) gets the same token filter as the access log below: a sign-in token is a
# credential and must not be written to any log (review of 13 October 2026, M6).
{
	log {
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>Referer query {
					delete token
				}
			}
		}
	}
}

{$DGATE_DOMAIN:localhost} {
	encode zstd gzip

	# includeSubDomains: the cookies are `__Host-` (no Domain) and the apex is the only host
	# with a certificate here, so a plain-http subdomain must not be a way in. No `preload`.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# This API takes GET requests with short query strings and nothing else.
	request_body {
		max_size 4KB
	}

	# Methods. The site and the API read with GET and HEAD, and the site's own forms are POST
	# (server actions). Anything else is a 405 here, not a page from the application: TRACE
	# answered 500 with the build id, and DELETE /tenders answered 200 with a public
	# Cache-Control (external audit X-9). A POST answer is never stored by a cache.
	@badmethod method TRACE TRACK PUT PATCH DELETE CONNECT
	handle @badmethod {
		header Allow "GET, HEAD, POST"
		respond "Method not allowed" 405
	}
	@post method POST
	header @post Cache-Control "no-store"

	# RFC 9116. `Contact` has to be a URI: the imprint page is where the operator's details go
	# (docs/legal), so that is the contact until they are there. No address is guessed.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		header Cache-Control "public, max-age=86400"
		respond <<TXT
			Contact: https://{$DGATE_DOMAIN:localhost}/imprint
			Expires: 2027-04-14T00:00:00.000Z
			Preferred-Languages: en
			Canonical: https://{$DGATE_DOMAIN:localhost}/.well-known/security.txt
			TXT 200
	}

	# Only what the product serves reaches the API. /docs, /openapi.json and any
	# route added later and forgotten are a 404 here, whatever the application
	# does.
	@public path /v1/funding /v1/funding/* /v1/opportunities /v1/opportunities/* /v1/calls /v1/calls/* /v1/tenders /v1/tenders/* /v1/buyers /v1/buyers/* /v1/stats/market /v1/sources /v1/health /v1/organisations/resolve
	handle @public {
		reverse_proxy api:8000 {
			# The proxy's own `Via: 1.1 Caddy` is not for clients (site-qa2:N16).
			header_down -Via
			transport http {
				dial_timeout 5s
				response_header_timeout 20s
			}
		}
	}

	# Anything else under /v1 is not the site's: a 404 here, not a page from the
	# frontend that happens to answer it.
	@api_rest path /v1 /v1/*
	handle @api_rest {
		respond "Not found" 404
	}

	# The site (docker-compose `web` profile). Down until the domain is live: Caddy
	# resolves web:3000 per request, so it can start first and answers 502 meanwhile.
	handle {
		reverse_proxy web:3000 {
			# Neither the proxy's `Via` nor the framework's cache and prerender markers are for clients.
			header_down -Via
			header_down -X-Nextjs-Cache
			header_down -X-Nextjs-Prerender
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# The access log must not hold a sign-in token: `/auth/verify?token=...` is a single-use
	# credential, and the same URL comes back as the `Referer` of the next same-site request.
	# The filter encoder drops the `token` query parameter from the logged URI and Referer
	# (review of 13 October 2026, M6). Everything else in the line is as before.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
				}
				request>headers>Referer query {
					delete token
				}
			}
		}
	}
}

# www is only a way in: send it to the one host the site and its certificate use.
# Needs a DNS record for www (CNAME to the apex, DNS only) before Caddy is reloaded,
# or the certificate request for it fails and is retried.
www.{$DGATE_DOMAIN} {
	redir https://{$DGATE_DOMAIN}{uri} permanent
}
