# Copy to infra/.env and fill in. Never commit the filled-in file.
POSTGRES_USER=dgate
POSTGRES_PASSWORD=
POSTGRES_DB=dgate

DGATE_DOMAIN=localhost

# Raw payload storage. Use s3 in production: the payloads are the only thing the
# archive cannot be rebuilt without, so they must not share a disk with the
# database. fs is for development only.
DGATE_RAW_BACKEND=s3
DGATE_S3_BUCKET=dgate-raw
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
DGATE_S3_ENDPOINT=
DGATE_S3_REGION=auto
# Leave empty to fall through to the instance role or the process environment.
# Never commit real values; infra/.env is gitignored for this reason.
DGATE_S3_ACCESS_KEY=
DGATE_S3_SECRET_KEY=

# The one-off TED history load. Empty means off. The Search API answers from
# 2017; a full load is about seven million notices, several days of running and
# roughly 80 GB in the object store. It resumes from day markers, so it is safe
# to stop and start.
DGATE_TED_HISTORY_FROM=
DGATE_TED_HISTORY_TO=

# Dump retention. The host keeps days, the object store keeps a month: the disk
# that holds the dumps also holds the database they are of.
DGATE_BACKUP_KEEP_DAYS=30
DGATE_BACKUP_KEEP_DAYS_LOCAL=7

# Alerting. Leave empty for log-only.
DGATE_HEALTHCHECKS_BASE=
DGATE_TELEGRAM_TOKEN=
DGATE_TELEGRAM_CHAT_ID=
