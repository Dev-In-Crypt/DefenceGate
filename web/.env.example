# Leave unset to serve mock data from lib/mock. Set to the API origin to go live.
DG_API_URL=
# Public origin of the site. A production build fails unless this starts with https://
# (it is also the host used in the canonical URLs, sitemap and robots.txt).
NEXT_PUBLIC_SITE_URL=https://defencegatehub.com
# Escape hatch for local previews of a production build only: lets the build run with
# NEXT_PUBLIC_SITE_URL unset. Never set it in a real deployment.
# DG_ALLOW_INSECURE_SITE_URL=1
#
# lib/deadline.ts can pin "now" for local demos and screenshots through a NEXT_PUBLIC_ variable.
# It is for local demos only, is deliberately not listed here, and must not be set in production.
# Same value as the API's DGATE_INTERNAL_SECRET (`openssl rand -hex 32`): sent as X-DG-Internal on every account call
# and on the visit counter. Server-side only, never NEXT_PUBLIC_. Leave unset for a local API without it.
DG_INTERNAL_SECRET=
# WP-122: 1 lets visitors choose a paid plan on /pricing (a "Choose" button to /signup?plan=...&billing=...). Unset or anything
# else: the page says "Opens soon". Read at build time. Leave unset until accounts and payment work and their terms are published.
# WP-124: payment (Creem) opens only when this is on AND the API has every DGATE_CREEM_* setting (infra/.env.example);
# otherwise /app/billing says "Payment opens soon" and no checkout is created. The site holds no Creem key or secret.
NEXT_PUBLIC_BILLING_OPEN=
